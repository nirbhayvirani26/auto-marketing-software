# ---------- AI PROVIDER (LAKHAN — caption, script, hashtags) ----------
# Gemini pehla. E fail thay (limit/down) to chain ma Groq -> OpenRouter ->
# Anthropic apoaap chale che, etle kaam kyarey atkatu nathi.
# vikalpo: auto | gemini | groq | openrouter | ollama | anthropic
AI_PROVIDER=gemini

# --- Google Gemini: FREE tier (recommended) ---
# aistudio.google.com/apikey par thi key lo - credit card ni jarur nathi
GEMINI_API_KEY=AIzaSyB7eqNBxZ3KJpdyl7EBZfIXcnbzfE2HpEo
GEMINI_MODEL=gemini-flash-latest

# --- Ollama: 100% free, tamara computer par ---
# ollama.com par thi install, pachi: ollama pull llama3.2
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b

# ═══════════════════════════════════════════════════════════════════
#  IMAGE — ChatGPT (OpenAI gpt-image-1)
#
#  Kayo pehla try karvo: openai | gemini-image | pollinations | replicate
#  Pehlo fail thay to niche na apoaap chale che.
# ═══════════════════════════════════════════════════════════════════
IMAGE_PROVIDER=openai

# platform.openai.com/api-keys par thi key lo (billing chalu hovu joiye)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# low | medium | high  — high sauthi saru, thodu maongu
OPENAI_IMAGE_QUALITY=high
# Azure ke proxy vaparta ho to j badlo
OPENAI_BASE_URL=https://api.openai.com/v1


# ═══════════════════════════════════════════════════════════════════
#  AI VIDEO — Google Flow nu "Omni" (Gemini Omni Flash)
#
#  Aa ffmpeg ni jagya e nathi. Reel to ffmpeg j banave che; Omni fakt
#  1-2 sauthi agatya na shot ne KHAREKHAR halta video ma badle che
#  (kapdu udtu, model fare, product vaparato dekhay).
#
#  Rasto: product photo -> gpt-image-1 (scene ni image) -> Omni (e j
#  image halave). Etle product/kapdu/chehro kyarey badlata nathi.
#
#  ⚠️ TESTED 2026-08-08: aa GEMINI_API_KEY par Omni CHALTU NATHI.
#     Google e HTTP 429 aapyu — "quota exceeded", etle free key ne aa
#     model nu quota 0 che. Billing chalu karo pachi `true` karo, biju
#     kai badalvanu nathi.
# ═══════════════════════════════════════════════════════════════════
AI_VIDEO_ENABLED=false
# Ek reel ma ketla AI clip (0 = sav bandh). Dareak clip ~1-2 minute.
AI_VIDEO_MAX_CLIPS=2
OMNI_MODEL=gemini-omni-flash-preview
VIDEO_PROVIDER=omni

N8N_API_TOKEN=amk_7rWGK3Y6-tcUl2bmt8ByWt_tmdyPpWv-

# ---------- n8n local login ----------
# `npm run n8n:setup` aa credentials thi n8n no owner account banave che.
# Badalvu hoy to: value badlo -> .n8n-data/ folder delete karo -> fari setup chalavo
N8N_EMAIL=n8n@automarketing.local
N8N_PASSWORD=N8nLocal@2026

# ═══════════════════════════════════════════════════════════════════
#  REEL STUDIO — navi keys (badhi FREE)
#  Jena par ⚠️ che e vagar auto-post NAHI thay.
# ═══════════════════════════════════════════════════════════════════

# ⭐ Gemini — EK key thi 4 kaam: lakhan, image samajvi, image banavvi, voiceover
#    aistudio.google.com/apikey  (credit card ni jarur nathi)
GEMINI_VISION_MODEL=gemini-flash-latest
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# ○ Vadhare free AI (limit lage to apoaap aa par jaay che)
GROQ_API_KEY=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
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_VISION_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free
ANTHROPIC_VISION_MODEL=claude-sonnet-5
VISION_PROVIDER=gemini

# ⚠️ PUBLIC MEDIA HOSTING — aa vagar Instagram/Facebook par post NAHI thay.
#    Meta na server tamari file download kare che, etle localhost nahi chale.
#    cloudinary.com → signup → Settings → Upload → Add upload preset
#    → Signing Mode: Unsigned → preset nu naam ahiya nakho
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
IMGBB_API_KEY=
# Potanu domain ke ngrok tunnel hoy to (aa hoy to Cloudinary ni jarur nathi)
PUBLIC_MEDIA_BASE_URL=
MEDIA_HOST=
MEDIA_ALLOW_ANON_HOSTS=true

# ○ Virtual try-on (kapdu vyakti par) — sauthi saacho result
REPLICATE_API_TOKEN=
REPLICATE_TRYON_VERSION=
TRYON_PROVIDER=
POLLINATIONS_MODEL=flux
POLLINATIONS_TOKEN=

# ⭐ Reel nu music — laakho Creative Commons track (free)
#    devportal.jamendo.com par thi client_id
#    ⚠️ Instagram nu trending SONG API thi lagavi shakatu nathi (Meta ni limit).
#       App reel ma copyright-free music naakhe che ane publish pachi IG app ma
#       trending sound kai rite lagavvo e batave che.
JAMENDO_CLIENT_ID=
MUSIC_DIR=

# ○ Voiceover
VOICEOVER_ENABLED=true
VOICEOVER_VOICE=female
TTS_PROVIDER=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Video engine — kai karvanu nathi, ffmpeg npm sathe j aave che
FFMPEG_PATH=
FFPROBE_PATH=
FONT_PATH=
RENDER_CONCURRENCY=3
REEL_MAX_CONCURRENT=2
REEL_WATERMARK=
YTDLP_PATH=

# Market ane trends
DEFAULT_MARKET=India
TRENDS_GEO=IN
AUDIENCE_TZ_OFFSET=330

# Storage
MEDIA_DIR=
