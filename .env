# ---------- Meta (Facebook + Instagram) Graph API ----------
META_GRAPH_VERSION=v21.0
META_APP_ID=1380611070682903
META_APP_SECRET=217fab6d738aa8cccbc326110aa59115

# Meta webhook (auto-DM) — Meta na Webhooks page ma aa j token nakhvo
