# ═══════════════════════════════════════════════════════════════════
#  Auto Marketing Software — Python edition
#
#  Aa file `python/.env` ma copy karo.
#
#  ⚠️ TAMARE AA BHARVANI JARUR NATHI HOI SHAKE:
#     project root nu `.env` PEHLA vanchay che. Tamara Meta ID/Secret,
#     MongoDB URI ane JWT_SECRET tya pehle thi che — e apoaap vaparashe.
#     Aa file fakt Python-khaas setting badalvi hoy tyare joiye.
#
#  ═══ BADHU FREE CHE. EK PAN PAID SERVICE NATHI. ═══
#
#  KAI J NAKHYA VAGAR PAN AA CHALE CHE:
#     • Video render   — ffmpeg (`python scripts/fetch_ffmpeg.py`)
#     • Public hosting — Catbox (koi key nahi)
#     • Music          — ccMixter (koi key nahi)
#     • Voiceover      — edge-tts (koi key nahi)
#     • Image banavvi  — Pollinations (koi key nahi)
#     • Trends         — Google Autocomplete + Trends (koi key nahi)
#
#  FAKT BE VASTU MATE KEY JOIYE (banne FREE, credit card nahi):
#     1. AI lakhan + image samajvi → Groq ke Gemini
#     2. Instagram/Facebook post   → Meta app (root .env ma pehle thi che)
# ═══════════════════════════════════════════════════════════════════


# ───────────── App ─────────────
PY_HOST=127.0.0.1
PY_PORT=8000
PY_APP_URL=http://localhost:8000
PY_DEBUG=false

# Session cookie sign karva mate. Khali rakho to root .env no JWT_SECRET
# vaparashe.
PY_SECRET_KEY=

# Python app no alag database — TS version na data sathe bhelsel na thay.
PY_MONGODB_DB=auto_marketing_py


# ═══════════════════════════════════════════════════════════════════
#  AI — BADHA FREE. Ochha ma ochho EK joiye.
#
#  Ek thi vadhu naakho to sauthi saru — ek ni free limit lage to bijo
#  apoaap chalu thai jaay che ane tamaru kaam atkatu nathi.
# ═══════════════════════════════════════════════════════════════════

# ⭐ 1. GROQ — free ane SAUTHI FAST (jawab millisecond ma)
#    https://console.groq.com/keys   (credit card ni jarur nathi)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ⭐ 2. GEMINI — free, ane AA EK KEY THI CHAAR KAAM THAY CHE:
#    lakhan + image samajvi + image banavvi (avatar!) + voiceover
#    https://aistudio.google.com/apikey   (credit card ni jarur nathi)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# ○ 3. OPENROUTER — ek key thi 300+ model, `:free` valaa muft
#    https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_VISION_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free

# ○ 4. OLLAMA — 100% free ane OFFLINE (tamara computer par)
#    https://ollama.com → install → `ollama pull llama3.2`
#    Image pan jovu hoy to: `ollama pull llava` ane OLLAMA_MODEL=llava
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=

# Kayo provider pehla try karvo (khali = apoaap)
AI_PROVIDER=
VISION_PROVIDER=


# ═══════════════════════════════════════════════════════════════════
#  PUBLIC MEDIA HOSTING — aa vagar auto-post NAHI thay
#
#  Meta na server TAMARI file download kare che, etle `localhost`
#  kyarey nahi chale.
#
#  KAI J NA KARO to Catbox par apoaap jashe (key vagar, free).
# ═══════════════════════════════════════════════════════════════════

# ⭐ SAUTHI SARU (ane free): potanu public URL
#    `ngrok http 8000` chalavo ane e https URL ahiya nakho.
#    Aa hoy to koi upload j nathi thatu — sauthi fast.
PUBLIC_MEDIA_BASE_URL=

# ○ Cloudinary — free 25GB CDN
#    cloudinary.com → Settings → Upload → Add upload preset → Unsigned
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# Key vagar na anonymous hosts (Catbox/tmpfiles) chalu rakhva?
# Production ma `false` karo — file public rahe che.
MEDIA_ALLOW_ANON_HOSTS=true

# Kayo host pehla: base-url | catbox | cloudinary | tmpfiles
MEDIA_HOST=


# ═══════════════════════════════════════════════════════════════════
#  MUSIC
#
#  ⚠️ Instagram nu TRENDING SONG API thi lagavi shakatu NATHI — Meta e
#     music catalog kholyu j nathi. Koi pan tool aa kari shakatu nathi.
#     App reel ma Creative Commons music bake kare che (auto-post thay
#     che, copyright strike no dar nathi) ane publish pachi batave che
#     ke IG app ma trending sound kai rite lagavvo (2 tap).
#
#  ccMixter KEY VAGAR chale che — kai nakhya vagar pan music aavse.
# ═══════════════════════════════════════════════════════════════════

# ○ Jamendo — laakho CC track, vadhu variety
#    https://devportal.jamendo.com (free client_id)
JAMENDO_CLIENT_ID=

# ○ Tamari potani mp3 no folder (khali = python/storage/music)
MUSIC_DIR=


# ═══════════════════════════════════════════════════════════════════
#  VOICEOVER — edge-tts KEY VAGAR chale che
# ═══════════════════════════════════════════════════════════════════

VOICEOVER_ENABLED=true
# female | male | warm | bright | calm — ke sidho Edge no voice naam
# (dakhla: gu-IN-DhwaniNeural)
VOICEOVER_VOICE=female
# edge-tts | gemini-tts (khali = apoaap)
TTS_PROVIDER=


# ═══════════════════════════════════════════════════════════════════
#  VIDEO ENGINE
# ═══════════════════════════════════════════════════════════════════

# Potanu ffmpeg vaparvu hoy to j bharo.
# `python scripts/fetch_ffmpeg.py` aa apoaap sambhali le che.
FFMPEG_PATH=
FFPROBE_PATH=
# Reel ma text mate khaas font (.ttf nu path)
FONT_PATH=

# Ek saathe ketla scene render thay (CPU pramane 2-4)
RENDER_CONCURRENCY=3
# Ek saathe ketla reel bane
REEL_MAX_CONCURRENT=2
# Dareak reel par nanu brand naam (khali = kai nahi)
REEL_WATERMARK=

# Reference reel LINK par thi utarvu hoy to (marji nu, ane tamari
# jawabdari). `pip install yt-dlp` pachi aa true karo.
# Saral rasto: video download karine app ma UPLOAD karo.
YTDLP_ENABLED=false


# ═══════════════════════════════════════════════════════════════════
#  META (Instagram + Facebook)
#
#  Aa root `.env` ma pehle thi che — ahiya fakt badalvu hoy to bharo.
# ═══════════════════════════════════════════════════════════════════

# META_APP_ID=
# META_APP_SECRET=
# META_GRAPH_VERSION=v21.0

# ⚠️ Meta app ma AA EXACT redirect URI nakhvu pade:
#      http://localhost:8000/api/oauth/meta/callback


# ═══════════════════════════════════════════════════════════════════
#  MARKET
# ═══════════════════════════════════════════════════════════════════

# Keywords ane price band kaya desh mate tune karva
DEFAULT_MARKET=India
# Google Trends no desh code
TRENDS_GEO=IN
# Audience no timezone offset (minute ma). IST = 330
AUDIENCE_TZ_OFFSET=330


# ═══════════════════════════════════════════════════════════════════
#  STORAGE
# ═══════════════════════════════════════════════════════════════════

# Upload thayeli image ane render thayela reels kya rakhva
# (khali = python/storage)
STORAGE_DIR=
MEDIA_DIR=
