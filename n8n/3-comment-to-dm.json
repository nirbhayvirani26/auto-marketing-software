{
  "name": "Auto Marketing — 3. Comment aave to AI jawab + DM",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "auto-marketing-events",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "hook",
      "name": "App Event Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-620, 0],
      "webhookId": "auto-marketing-events",
      "notes": "App na .env ma N8N_WEBHOOK_URL ahiya no Production URL nakho"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "conditions": [
            {
              "leftValue": "={{ $json.headers['x-n8n-secret'] }}",
              "rightValue": "={{ $env.AM_N8N_SECRET }}",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "verify",
      "name": "Secret Verify",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-400, 0]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": true, "version": 2 },
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.event }}",
                    "rightValue": "post.published",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "published"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "version": 2 },
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.event }}",
                    "rightValue": "post.failed",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "failed"
            }
          ]
        },
        "options": { "fallbackOutput": "extra" }
      },
      "id": "router",
      "name": "Event Router",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [-180, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "m",
              "name": "message",
              "type": "string",
              "value": "=✅ Live thayu: {{ $json.body.payload.platform }} → {{ $json.body.payload.permalink }}"
            }
          ]
        }
      },
      "id": "on-pub",
      "name": "Publish Thayu",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [80, -160]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "m",
              "name": "message",
              "type": "string",
              "value": "=❌ Fail: {{ $json.body.payload.error }}"
            }
          ]
        }
      },
      "id": "on-fail",
      "name": "Publish Fail",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [80, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "m",
              "name": "message",
              "type": "string",
              "value": "=ℹ️ {{ $json.body.event }}"
            }
          ]
        }
      },
      "id": "on-other",
      "name": "Biju Event",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [80, 160]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, message: $json.message } }}"
      },
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [340, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseCode": 401,
        "responseBody": "={{ { ok: false, error: 'Invalid secret' } }}"
      },
      "id": "reject",
      "name": "Reject",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [-180, 220]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "manual-comment-reply",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "manual-hook",
      "name": "Manual: Comment Reply Magavo",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-620, 420],
      "webhookId": "manual-comment-reply",
      "notes": "Body: { \"comment\": \"price?\", \"platform\": \"instagram\", \"username\": \"ravi\" }"
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "={{ $env.AM_BASE_URL }}/api/v1/generate",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.AM_TOKEN }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ comment: $json.body.comment, username: $json.body.username, platform: $json.body.platform || 'instagram', instruction: $json.body.instruction }) }}",
        "options": { "timeout": 180000 }
      },
      "id": "ai-reply",
      "name": "AI Jawab Banavo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-360, 420]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, publicReply: $json.data.publicReply, dm: $json.data.dm } }}"
      },
      "id": "respond2",
      "name": "Jawab Pacho Moklo",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [-100, 420]
    }
  ],
  "connections": {
    "App Event Webhook": { "main": [[{ "node": "Secret Verify", "type": "main", "index": 0 }]] },
    "Secret Verify": {
      "main": [
        [{ "node": "Event Router", "type": "main", "index": 0 }],
        [{ "node": "Reject", "type": "main", "index": 0 }]
      ]
    },
    "Event Router": {
      "main": [
        [{ "node": "Publish Thayu", "type": "main", "index": 0 }],
        [{ "node": "Publish Fail", "type": "main", "index": 0 }],
        [{ "node": "Biju Event", "type": "main", "index": 0 }]
      ]
    },
    "Publish Thayu": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] },
    "Publish Fail": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] },
    "Biju Event": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] },
    "Manual: Comment Reply Magavo": {
      "main": [[{ "node": "AI Jawab Banavo", "type": "main", "index": 0 }]]
    },
    "AI Jawab Banavo": {
      "main": [[{ "node": "Jawab Pacho Moklo", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {},
  "meta": { "instanceId": "auto-marketing" },
  "tags": []
}
