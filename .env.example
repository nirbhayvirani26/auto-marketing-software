╔════════════════════════════════════════════════════════════════════╗
║  Auto Marketing Software — configuration                           ║
║                                                                    ║
║  Copy this file to `.env` and fill in what you need.               ║
║                                                                    ║
║      cp .env.example .env        (Windows:  copy .env.example .env)║
║                                                                    ║
║  You can leave the whole file empty and the app will still start.  ║
║  The database is local, the sign-in key is generated on first run, ║
║  and every service below degrades to a working fallback.           ║
║                                                                    ║
║  Legend:  ⭐ strongly recommended   ○ optional   ✅ nothing to do   ║
╚════════════════════════════════════════════════════════════════════╝

# ═══════════════════════════════════════════════════════════════════
#  APP ✅
# ═══════════════════════════════════════════════════════════════════

APP_URL=http://localhost:3000
NODE_ENV=development


# ═══════════════════════════════════════════════════════════════════
#  DATABASE ✅ — nothing to install
#
#  Every collection is a JSON file in a folder next to the source
#  code. No server, no connection string, no service to keep running.
#  Copy the project folder and the content travels with it.
#
#  The folder holds password hashes and Page access tokens, so it is
#  excluded from git. A fresh copy of the project seeds itself on the
#  first sign-in, using SEED_ADMIN_* below.
# ═══════════════════════════════════════════════════════════════════

# Where the JSON collections live, relative to the project root.
LOCAL_DB_DIR=data


# ═══════════════════════════════════════════════════════════════════
#  SIGN-IN ✅
#
#  Leave JWT_SECRET empty and a strong random key is generated once
#  and stored in `data/.session-secret`. Set it explicitly only when
#  you run several instances that must share sessions.
# ═══════════════════════════════════════════════════════════════════

JWT_SECRET=
JWT_EXPIRES_IN=7d

# The owner account created on first run.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=Workspace Owner

# The platform-wide super admin, who can see every organization.
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=Super@12345


# ═══════════════════════════════════════════════════════════════════
#  TEXT AI ⭐ — writes captions, scripts and hashtags
#
#  Every provider below is tried in turn. If one hits its rate limit
#  or goes down, the next one takes over, so generation keeps working.
#  One free Gemini key is enough to run the entire app.
# ═══════════════════════════════════════════════════════════════════

# Which provider to try first: gemini | groq | openrouter | ollama | anthropic
AI_PROVIDER=gemini

# ⭐ Gemini — one key covers four jobs: writing, reading images,
#    generating images (Nano Banana) and voiceover.
#    Free, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_VISION_MODEL=gemini-flash-latest
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# ○ Groq — free and very fast. https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ○ OpenRouter — free models. https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_VISION_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free

# ○ Ollama — runs on your own machine, completely free and offline.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=

# ○ Anthropic Claude — paid, and the strongest writer of the group.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_VISION_MODEL=claude-sonnet-5

# Which provider reads product photos. Empty = same order as above.
VISION_PROVIDER=


# ═══════════════════════════════════════════════════════════════════
#  IMAGE GENERATION ⭐ — Nano Banana
#
#  Nano Banana is Google's Gemini 2.5 Flash Image. It is the default
#  here for three reasons: it is on the free tier, it reads reference
#  photos, and it keeps a face consistent from scene to scene — which
#  is exactly what an avatar needs.
#
#  It uses GEMINI_API_KEY above; there is no separate key to get.
#
#  Order to try: nano-banana | openai | pollinations | replicate
# ═══════════════════════════════════════════════════════════════════

IMAGE_PROVIDER=nano-banana

# ○ OpenAI gpt-image-1 — paid, and the only model that reliably
#   renders readable text inside an image.
#   https://platform.openai.com/api-keys  (billing must be enabled)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# low | medium | high
OPENAI_IMAGE_QUALITY=high
OPENAI_BASE_URL=https://api.openai.com/v1

# ○ Pollinations — the keyless fallback. Backgrounds and lifestyle
#   shots only; it cannot work from a reference photo.
POLLINATIONS_MODEL=flux
POLLINATIONS_TOKEN=

# ○ Replicate — the most accurate virtual try-on (IDM-VTON), a few
#   cents per image. https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
REPLICATE_TRYON_VERSION=
TRYON_PROVIDER=


# ═══════════════════════════════════════════════════════════════════
#  AI VIDEO ○ — Omni (Gemini Omni Flash)
#
#  This does NOT replace ffmpeg. ffmpeg builds every reel by moving
#  still images, which is fast and free. Omni turns the one or two
#  most important shots into real motion — fabric moving, a model
#  turning, the product actually being used.
#
#  The route is always: product photo -> scene image -> Omni animates
#  that exact image. Generating from text alone lets the model invent
#  its own product, and the colour and print come out wrong.
#
#  Omni uses GEMINI_API_KEY, but it sits on the PAID tier. On a free
#  key it returns HTTP 429 (quota 0). Turn billing on, then set
#  AI_VIDEO_ENABLED=true. Reels render fine without it either way.
# ═══════════════════════════════════════════════════════════════════

AI_VIDEO_ENABLED=false
# Clips per reel (0 turns it off). Each clip takes one to two minutes.
AI_VIDEO_MAX_CLIPS=2
OMNI_MODEL=gemini-omni-flash-preview
VIDEO_PROVIDER=omni


# ═══════════════════════════════════════════════════════════════════
#  MEDIA HOSTING ⚠️ — required before anything can be published
#
#  Meta downloads your file from its own servers, so `localhost` will
#  never work. Set up one of these.
# ═══════════════════════════════════════════════════════════════════

# ⭐ Cloudinary — free 25GB CDN. https://cloudinary.com
#    Create an UNSIGNED upload preset and put its name below.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ○ ImgBB — free, images only. https://api.imgbb.com
IMGBB_API_KEY=

# ○ Your own domain or an ngrok tunnel, if you would rather self-host.
PUBLIC_MEDIA_BASE_URL=

# Force one host: cloudinary | imgbb | catbox | local. Empty = auto.
MEDIA_HOST=

# Keyless anonymous hosts (Catbox, tmpfiles) as a last resort. They
# work, but files are publicly readable and tmpfiles deletes after an
# hour. Set this to false in production.
MEDIA_ALLOW_ANON_HOSTS=true

# Where uploads and rendered reels are written on disk.
MEDIA_DIR=


# ═══════════════════════════════════════════════════════════════════
#  MUSIC ○
#
#  A note on trending sounds: Instagram's licensed trending audio
#  CANNOT be attached through the Graph API. Meta has never opened
#  the music catalogue, so no tool can do it — this is a platform
#  limitation, not a gap in this app.
#
#  So the app bakes a copyright-free track into the reel, and after
#  publishing it tells you which trending sound to search for in the
#  Instagram app. That is two taps, and it still earns the boost.
# ═══════════════════════════════════════════════════════════════════

# ⭐ Jamendo — hundreds of thousands of Creative Commons tracks.
#    https://devportal.jamendo.com
JAMENDO_CLIENT_ID=

# ○ A folder of your own mp3 files. Empty = storage/music
MUSIC_DIR=


# ═══════════════════════════════════════════════════════════════════
#  VOICEOVER ○
# ═══════════════════════════════════════════════════════════════════

VOICEOVER_ENABLED=true
# female | male | warm | bright | calm
VOICEOVER_VOICE=female
# gemini-tts | pollinations-tts | elevenlabs. Empty = auto.
TTS_PROVIDER=

# ○ ElevenLabs — the best-sounding voice. Free tier: 10,000
#   characters a month. https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2


# ═══════════════════════════════════════════════════════════════════
#  VIDEO ENGINE ✅ — nothing to do
#
#  ffmpeg arrives with `npm install`. Run `npm run fonts` once so
#  reel text renders (optional — system fonts also work).
# ═══════════════════════════════════════════════════════════════════

# Only set these to use your own ffmpeg build.
FFMPEG_PATH=
FFPROBE_PATH=
# A specific .ttf for reel text.
FONT_PATH=

# Scenes rendered at once. Two to four, depending on your CPU.
RENDER_CONCURRENCY=3
# Reels built at once.
REEL_MAX_CONCURRENT=2
# A small brand name burned onto every reel. Empty = none.
REEL_WATERMARK=

# Path to yt-dlp, if you want to pull a reference reel from a link.
# Optional — uploading the video file directly is simpler.
YTDLP_PATH=


# ═══════════════════════════════════════════════════════════════════
#  META (Facebook + Instagram) ⭐ — required to publish
# ═══════════════════════════════════════════════════════════════════

META_GRAPH_VERSION=v21.0

# Create an app at https://developers.facebook.com/apps (type: Business)
#   → add the Facebook Login product
#   → in Facebook Login → Settings → Valid OAuth Redirect URIs, add
#     this EXACT url:
#        http://localhost:3000/api/oauth/meta/callback
META_APP_ID=
META_APP_SECRET=

# Any string you choose. Meta echoes it back when verifying the
# webhook that powers auto-replies and auto-DMs.
META_WEBHOOK_VERIFY_TOKEN=change_this_webhook_verify_token

# ○ A long-lived Page token, if you prefer to skip the OAuth flow.
META_DEFAULT_ACCESS_TOKEN=


# ═══════════════════════════════════════════════════════════════════
#  AUDIENCE ○ — shapes trends, language and posting times
# ═══════════════════════════════════════════════════════════════════

DEFAULT_MARKET=India
# Google Trends region code: IN, US, GB …
TRENDS_GEO=IN
# Minutes from UTC for your audience. India = 330.
AUDIENCE_TZ_OFFSET=330


# ═══════════════════════════════════════════════════════════════════
#  SCHEDULER ⭐
#
#  Scheduled posts and automations only run while
#  /api/cron/dispatch is called once a minute. Use an n8n Schedule
#  Trigger, or Windows Task Scheduler.
# ═══════════════════════════════════════════════════════════════════

CRON_SECRET=change_this_cron_secret


# ═══════════════════════════════════════════════════════════════════
#  n8n ○ — optional workflow automation
# ═══════════════════════════════════════════════════════════════════

N8N_BASE_URL=http://localhost:5678
# The app POSTs events here (post.published, automation.completed …)
N8N_WEBHOOK_URL=
# Shared secret for inbound commands to /api/webhooks/n8n
N8N_WEBHOOK_SECRET=
# Created for you by `npm run n8n:setup`
N8N_API_TOKEN=
N8N_EMAIL=n8n@automarketing.local
N8N_PASSWORD=N8nLocal@2026
