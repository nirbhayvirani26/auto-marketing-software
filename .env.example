# ═══════════════════════════════════════════════════════════════════
#  Auto Marketing Software — .env
#
#  Aa file `.env` ma copy karo ane bharo.
#  Farjiyat = ✅ · Marji nu = ○ · Recommended = ⭐
#
#  SAUTHI ZADAPI SHURUAAT (5 minute, badhu FREE):
#     1. GEMINI_API_KEY        → aistudio.google.com/apikey
#     2. CLOUDINARY_*          → cloudinary.com (free 25GB)
#     3. JAMENDO_CLIENT_ID     → devportal.jamendo.com
#     4. META_APP_ID/SECRET    → developers.facebook.com/apps
#  Aatlathi aakhu tool chale che.
# ═══════════════════════════════════════════════════════════════════


# ───────────── App ─────────────
APP_URL=http://localhost:3000
NODE_ENV=development


# ───────────── MongoDB ✅ ─────────────
MONGODB_URI=mongodb://127.0.0.1:27017/auto_marketing
MONGODB_DB=auto_marketing


# ───────────── Auth ✅ ─────────────
# `openssl rand -base64 48` thi generate karo (32+ akshar)
JWT_SECRET=change_this_to_a_long_random_secret_string_min_32_chars
JWT_EXPIRES_IN=7d

# Pehli var seed karva mate admin user
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=Super Admin


# ═══════════════════════════════════════════════════════════════════
#  AI — LAKHAN (caption, hashtags, reel script)
#
#  Ochha ma ochho EK joiye ✅. Ek thi vadhu naakho to sauthi saru —
#  ek ni free limit lage to bijo apoaap chalu thai jaay che, ane
#  tamaru kaam kyarey atkatu nathi.
# ═══════════════════════════════════════════════════════════════════

# Gemini pehla, ane e fail thay to niche na apoaap chale che.
# auto = je configure hoy e (free ne pehli pasandgi)
# vikalpo: auto | gemini | groq | openrouter | ollama | anthropic
AI_PROVIDER=gemini

# ⭐ Google Gemini — FREE, credit card ni jarur nathi
#    aistudio.google.com/apikey
#    Aa EK key thi 4 kaam thai jaay che: lakhan, image samajvi,
#    image banavvi, ane voiceover. Sauthi pehla aa j lo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# ○ Groq — FREE ane bahu j fast. console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ○ OpenRouter — ek key thi 300+ model, `:free` valaa muft. openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_VISION_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free

# ○ Ollama — 100% free, tamara potana computer par. ollama.com
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=

# ○ Anthropic Claude — sauthi sachot, pan paid
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_VISION_MODEL=claude-sonnet-5

# Kayo vision provider pehla try karvo (khali = auto)
VISION_PROVIDER=


# ═══════════════════════════════════════════════════════════════════
#  PUBLIC MEDIA HOSTING ✅ — aa vagar auto-post NAHI thay
#
#  Meta na server TAMARI file download kare che. Etle `localhost`
#  kyarey nahi chale — public https URL joiye j.
# ═══════════════════════════════════════════════════════════════════

# ⭐ Cloudinary — free 25GB, video support, kayami URL. Sauthi saru.
#    cloudinary.com par signup → Settings → Upload →
#    "Add upload preset" → Signing Mode: Unsigned → naam copy karo
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
# (preset na banavvu hoy to aa be pan chale)
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ○ ImgBB — fakt image. api.imgbb.com
IMGBB_API_KEY=

# ○ Tamaru potanu domain / ngrok tunnel.
#    Aa set karsho to /api/media sidhu vaparashe (koi upload nahi).
#    Dakhla: https://abcd-12-34.ngrok-free.app
PUBLIC_MEDIA_BASE_URL=

# Kayo host pehla try karvo: cloudinary | imgbb | catbox | tmpfiles
MEDIA_HOST=

# Key vagar na anonymous hosts (catbox/tmpfiles) chalu rakhva?
# Production ma `false` karo — public file kaayam bahar rahe che.
MEDIA_ALLOW_ANON_HOSTS=true


# ═══════════════════════════════════════════════════════════════════
#  IMAGE GENERATION ○ — avatar + kapda, lifestyle shots
#
#  Na hoy to pan reel banse — fakt tamari upload kareli image thi.
# ═══════════════════════════════════════════════════════════════════

# Kayo pehla try karvo: openai | gemini-image | pollinations | replicate
# Pehlo fail thay to niche na apoaap chale che.
IMAGE_PROVIDER=openai

# ⭐ OpenAI gpt-image-1 (ChatGPT ni image API) — sauthi saru pariman.
#    Product ni vigat ane chehro barabar sachve che (input_fidelity: high),
#    ane image par lakhelu text pan saachu aave che.
#    platform.openai.com/api-keys  (billing chalu hovu joiye — paid)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# low | medium | high
OPENAI_IMAGE_QUALITY=high
# Azure ke proxy vaparta ho to j badlo
OPENAI_BASE_URL=https://api.openai.com/v1

POLLINATIONS_MODEL=flux
POLLINATIONS_TOKEN=

# ○ Replicate — sauthi saacho virtual try-on (kapdu vyakti par).
#    Ek image na ~₹2. replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
REPLICATE_TRYON_VERSION=
TRYON_PROVIDER=


# ═══════════════════════════════════════════════════════════════════
#  REEL NU MUSIC ○
#
#  ⚠️ Instagram nu TRENDING SONG API thi lagavi shakatu NATHI —
#     Meta e music catalog API ma kholyu j nathi. Aa koi pan tool
#     kari shakatu nathi. App reel ma copyright-free music bake kare
#     che, ane publish pachi IG app ma trending sound kai rite lagavvo
#     e batave che (2 tap nu kaam).
# ═══════════════════════════════════════════════════════════════════

# ⭐ Jamendo — laakho Creative Commons track. devportal.jamendo.com
JAMENDO_CLIENT_ID=

# ○ Tamari potani mp3 no folder (khali = storage/music)
MUSIC_DIR=


# ═══════════════════════════════════════════════════════════════════
#  VOICEOVER ○
# ═══════════════════════════════════════════════════════════════════

VOICEOVER_ENABLED=true
# female | male | warm | bright | calm
VOICEOVER_VOICE=female
# gemini-tts | pollinations-tts | elevenlabs (khali = auto)
TTS_PROVIDER=

# ○ ElevenLabs — sauthi saaro awaj. Free 10,000 akshar/mahino.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2


# ═══════════════════════════════════════════════════════════════════
#  VIDEO ENGINE — kai karvanu nathi ✅
#
#  ffmpeg `npm install` sathe j aavi jaay che. Fonts mate ek var
#  `npm run fonts` chalavo (aa pan marji nu — system na font pan chale).
# ═══════════════════════════════════════════════════════════════════

# ───────── AI VIDEO ○ — Google Flow nu "Omni" (Gemini Omni Flash) ─────────
#
#  Aa ffmpeg ni JAGYA E nathi. Reel to ffmpeg j banave che. Omni fakt
#  1-2 sauthi agatya na shot ne kharekhar halta video ma badle che —
#  kapdu udtu, model fare, product vaparato dekhay.
#
#  Rasto: product photo → gpt-image-1 (scene ni image) → Omni (e j image
#  halave). Etle product, kapdu ke chehro kyarey badlata nathi.
#
#  Key e j GEMINI_API_KEY che. Omni paid tier ma che — free key hoy to
#  aa apoaap skip thay che ane reel jem nu tem bane che.
AI_VIDEO_ENABLED=true
# Ek reel ma ketla AI clip (0 = sav bandh). Dareak clip ~1-2 minute lage che.
AI_VIDEO_MAX_CLIPS=2
OMNI_MODEL=gemini-omni-flash-preview
VIDEO_PROVIDER=omni

# Potanu ffmpeg vaparvu hoy to j bharo
FFMPEG_PATH=
FFPROBE_PATH=
# Reel ma text mate khaas font vaparvo hoy to (.ttf nu path)
FONT_PATH=

# Ek saathe ketla scene render thay (CPU pramane 2-4 rakho)
RENDER_CONCURRENCY=3
# Ek saathe ketla reel bane
REEL_MAX_CONCURRENT=2
# Dareak reel par nanu brand naam (khali = kai nahi)
REEL_WATERMARK=

# Reference reel LINK par thi utarvu hoy to yt-dlp nu path.
# Aa marji nu che — saral rasto: video download karine app ma upload karo.
YTDLP_PATH=


# ═══════════════════════════════════════════════════════════════════
#  META (Facebook + Instagram) ✅
# ═══════════════════════════════════════════════════════════════════

META_GRAPH_VERSION=v21.0

# developers.facebook.com/apps par app banavo
#   → Facebook Login product add karo
#   → Valid OAuth Redirect URIs ma AA EXACT URL nakho:
#        http://localhost:3000/api/oauth/meta/callback
#     (production ma APP_URL pramane badlo)
#   → Permissions: pages_manage_posts, pages_read_engagement,
#     instagram_basic, instagram_content_publish,
#     instagram_manage_comments, instagram_manage_messages
META_APP_ID=
META_APP_SECRET=

# Meta na Webhooks page ma aa j token nakhvo
META_WEBHOOK_VERIFY_TOKEN=change_this_webhook_verify_token

# Optional fallback token (per-account token Accounts page mathi set thay che)
META_DEFAULT_ACCESS_TOKEN=


# ═══════════════════════════════════════════════════════════════════
#  MARKET ane TRENDS
# ═══════════════════════════════════════════════════════════════════

# Keywords ane price band kaya desh mate tune karva
DEFAULT_MARKET=India
# Google Trends no desh code
TRENDS_GEO=IN
# Audience no timezone offset (minute ma). IST = 330
AUDIENCE_TZ_OFFSET=330


# ═══════════════════════════════════════════════════════════════════
#  CRON ✅ — scheduled post ane atkela reel job mate
#
#  Dar minute aane call karo:
#    curl -X POST http://localhost:3000/api/cron/dispatch \
#         -H "x-cron-secret: <CRON_SECRET>"
# ═══════════════════════════════════════════════════════════════════

CRON_SECRET=change_this_cron_secret


# ═══════════════════════════════════════════════════════════════════
#  n8n ○ — vadharana automation joita hoy to
# ═══════════════════════════════════════════════════════════════════

N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook/auto-marketing
N8N_WEBHOOK_SECRET=change_this_n8n_shared_secret

# `npm run n8n:setup` aa credentials thi n8n no owner account banave che.
N8N_EMAIL=n8n@automarketing.local
N8N_PASSWORD=N8nLocal@2026


# ═══════════════════════════════════════════════════════════════════
#  STORAGE ○
# ═══════════════════════════════════════════════════════════════════

# Upload thayeli file ane render thayela reels kya rakhva (khali = storage/media)
MEDIA_DIR=
