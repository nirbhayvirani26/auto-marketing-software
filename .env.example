# ---------- App ----------
APP_URL=http://localhost:3000
NODE_ENV=development

# ---------- MongoDB (local) ----------
MONGODB_URI=mongodb://127.0.0.1:27017/auto_marketing
MONGODB_DB=auto_marketing

# ---------- Auth ----------
# `openssl rand -base64 48` thi generate karo
JWT_SECRET=change_this_to_a_long_random_secret_string_min_32_chars
JWT_EXPIRES_IN=7d

# Pehli var seed karva mate admin user
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=Super Admin

# ---------- Anthropic (AI content generation) ----------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-opus-5

# ---------- n8n ----------
# n8n ma Webhook node banavi ne e URL ahiya nakho
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook/auto-marketing
# n8n -> aapdi app ne call kare tyare aa secret header ma moklvo: x-n8n-secret
N8N_WEBHOOK_SECRET=change_this_n8n_shared_secret

# ---------- Internal cron ----------
# /api/cron/dispatch ne call karva mate: header x-cron-secret
CRON_SECRET=change_this_cron_secret

# ---------- Meta (Facebook + Instagram) Graph API ----------
META_GRAPH_VERSION=v21.0

# "Connect with Facebook" button mate joiye che.
# developers.facebook.com/apps par app banavo -> Facebook Login product add karo
# -> Valid OAuth Redirect URIs ma aa exact URL nakho:
#      http://localhost:3000/api/oauth/meta/callback
# (production ma APP_URL pramane badlo)
META_APP_ID=
META_APP_SECRET=

# Meta webhook (auto-DM) — Meta na Webhooks page ma aa j token nakhvo
META_WEBHOOK_VERIFY_TOKEN=change_this_webhook_verify_token

# Optional fallback token (per-account token Accounts page mathi set thay che)
META_DEFAULT_ACCESS_TOKEN=

# ---------- AI PROVIDER (free options) ----------
# auto = je configure hoy e vaparo (FREE ne pehli pasandgi)
# vikalpo: auto | gemini | ollama | anthropic
AI_PROVIDER=auto

# --- Google Gemini: FREE tier (recommended) ---
# aistudio.google.com/apikey par thi key lo - credit card ni jarur nathi
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Ollama: 100% free, tamara computer par ---
# ollama.com par thi install, pachi: ollama pull llama3.2
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=

# ---------- IMAGE GENERATION (free) ----------
# pollinations = sav free koi key nahi | gemini = Imagen (key joiye)
IMAGE_PROVIDER=pollinations

# ---------- n8n local login ----------
# `npm run n8n:setup` aa credentials thi n8n no owner account banave che.
# Badalvu hoy to: value badlo -> .n8n-data/ folder delete karo -> fari setup chalavo
N8N_EMAIL=n8n@automarketing.local
N8N_PASSWORD=N8nLocal@2026
