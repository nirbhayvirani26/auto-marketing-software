# Secrets — .env holds live API keys and must never be committed.
# Copy .env.example to .env and fill it in locally.
.env
.env.local
.env.*.local

node_modules
.next
out
build
*.log
.DS_Store
next-env.d.ts
tsconfig.tsbuildinfo

# Local database — one JSON file per collection, plus the generated session
# key. It holds password hashes and page access tokens, so it stays out of git.
# A fresh clone seeds itself on first start (see src/lib/bootstrap.ts).
data/

# Uploaded images, rendered reels and temporary render files
storage/

# n8n local data (workflows, credentials, encryption key)
.n8n-data/

# Python edition — downloaded binaries, fonts and rendered reels
python/storage/
python/vendor/
python/assets/fonts/
python/.env
__pycache__/
*.py[cod]
